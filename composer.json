{
    "name": "leonel/php-redis",
    "description": "project to learn redis",
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "leonelrosado",
            "email": "leonelrosado2407@gmail.com"
        }
    ],
    "require": {
        "slim/slim": "4.*",
        "slim/psr7": "^1.8",
        "php-di/php-di": "7.0",
        "vlucas/phpdotenv": "^5.6",
        "firebase/php-jwt": "^7.1",
        "monolog/monolog": "^3.10"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
